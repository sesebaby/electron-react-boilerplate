{
  "name": "inventory-management",
  "version": "1.0.0",
  "description": "Beautiful inventory management system built with Electron and React",
  "main": "public/main.js",
  "scripts": {
    "start": "concurrently \"npm run build:watch\" \"npm run electron\"",
    "build": "cross-env NODE_ENV=production FORCE_REAL_DATABASE=true npx webpack --mode production",
    "build:watch": "npx webpack --mode development --watch",
    "electron": "electron .",
    "dev": "npx webpack serve --config webpack.dev.config.js",
    "dev:electron": "npx webpack serve --mode development",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:unit": "jest --testPathPatterns='^((?!integration|e2e).)*\\.test\\.(ts|tsx)$'",
    "test:integration": "jest --config jest.config.integration.js",
    "test:contract": "jest --config jest.config.contract.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract",
    "prestart": "node scripts/pre-start-check.js",
    "production-check": "cross-env NODE_ENV=production FORCE_REAL_DATABASE=true node scripts/production-check.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test e2e/ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:auth": "playwright test e2e/auth",
    "test:e2e:inventory": "playwright test e2e/inventory",
    "test:e2e:system": "playwright test e2e/system",
    "test:e2e:database": "playwright test e2e/database",
    "test:e2e:integration": "playwright test e2e/integration",
    "test:performance": "playwright test --project=performance",
    "test:ci": "npm run test:e2e && npm run test:coverage",
    "test:coverage": "jest --coverage",
    "test:report": "playwright show-report",
    "cleanup-data": "ts-node scripts/cleanup-data.ts",
    "test-data-flow": "ts-node scripts/test-data-flow.ts",
    "reset-db": "node simple-reset.js",
    "package": "cross-env NODE_ENV=production FORCE_REAL_DATABASE=true npm run build && electron-builder --publish=never",
    "package:win": "cross-env NODE_ENV=production FORCE_REAL_DATABASE=true npm run build && electron-builder --win",
    "package:mac": "cross-env NODE_ENV=production FORCE_REAL_DATABASE=true npm run build && electron-builder --mac",
    "package:linux": "cross-env NODE_ENV=production FORCE_REAL_DATABASE=true npm run build && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/sqlite3": "^3.1.11",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^7.1.1",
    "date-fns": "^4.1.0",
    "electron": "^30.0.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.30.1",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.3.7",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "util": "^0.12.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.60.0",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.71"
  },
  "author": "",
  "license": "MIT"
}
